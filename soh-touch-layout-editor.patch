+    // ------------------------------------------------------------------
+    // Touch layout editor: move and resize the on-screen controls.
+    // Opened from the native menu (Settings > Touch Controls > Edit Touch Layout).
+    // Per-control offset (dp) and scale are stored in SharedPreferences.
+    // ------------------------------------------------------------------
+    private static final String PREF_TOUCH_LAYOUT_PREFIX = "touchLayout_";
+    private static final float TOUCH_SCALE_MIN = 0.5f;
+    private static final float TOUCH_SCALE_MAX = 2.0f;
+
+    private View dpadCluster;
+    private View actionButtonCluster;
+    private final LinkedHashMap<String, View> touchElements = new LinkedHashMap<>();
+    private final Map<String, View[]> touchEditTargets = new LinkedHashMap<>();
+    private final Map<View, Float> touchUserScale = new HashMap<>();
+    private boolean touchLayoutEditing = false;
+    private String selectedTouchElement = null;
+    private float leftStickScale = 1.0f;
+    private float dragLastRawX;
+    private float dragLastRawY;
+    private boolean updatingTouchSeek = false;
+    private LinearLayout touchEditPanel;
+    private TextView touchEditLabel;
+    private SeekBar touchEditSeek;
+
+    private void registerTouchElement(String key, View main, View... targets) {
+        if (main == null) {
+            return;
+        }
+        touchElements.put(key, main);
+        touchEditTargets.put(key, targets);
+    }
+
+    private void registerTouchLayoutElements() {
+        touchElements.clear();
+        touchEditTargets.clear();
+        registerTouchElement("stick", leftJoystick, leftJoystick);
+        registerTouchElement("dpad", dpadCluster, dpadCluster,
+                buttonDpadUp, buttonDpadDown, buttonDpadLeft, buttonDpadRight);
+        registerTouchElement("face", actionButtonCluster, actionButtonCluster,
+                buttonA, buttonB, buttonX, buttonY);
+        registerTouchElement("zl", buttonZL, buttonZL);
+        registerTouchElement("lb", buttonLB, buttonLB);
+        registerTouchElement("zr", buttonZR, buttonZR);
+        registerTouchElement("rb", buttonRB, buttonRB);
+        registerTouchElement("start", buttonStart, buttonStart);
+        registerTouchElement("back", buttonBack, buttonBack);
+    }
+
+    private String touchElementLabel(String key) {
+        switch (key) {
+            case "stick": return "Left Stick (fixed mode)";
+            case "dpad": return "D-Pad";
+            case "face": return "Face Buttons";
+            case "zl": return "ZL";
+            case "lb": return "L";
+            case "zr": return "ZR";
+            case "rb": return "R";
+            case "start": return "Start";
+            case "back": return "Back";
+            default: return key;
+        }
+    }
+
+    private float getTouchElementDx(String key) {
+        return preferences.getFloat(PREF_TOUCH_LAYOUT_PREFIX + key + "_dx", 0.0f);
+    }
+
+    private float getTouchElementDy(String key) {
+        return preferences.getFloat(PREF_TOUCH_LAYOUT_PREFIX + key + "_dy", 0.0f);
+    }
+
+    private float getTouchElementScale(String key) {
+        return clampTouchScale(preferences.getFloat(PREF_TOUCH_LAYOUT_PREFIX + key + "_scale", 1.0f));
+    }
+
+    private float clampTouchScale(float scale) {
+        return Math.max(TOUCH_SCALE_MIN, Math.min(TOUCH_SCALE_MAX, scale));
+    }
+
+    private float density() {
+        return getResources().getDisplayMetrics().density;
+    }
+
+    private void applySavedTouchLayout() {
+        for (String key : touchElements.keySet()) {
+            applyTouchElementLayout(key);
+        }
+    }
+
+    private void applyTouchElementLayout(String key) {
+        View v = touchElements.get(key);
+        if (v == null) {
+            return;
+        }
+        float scale = getTouchElementScale(key);
+        v.setTranslationX(getTouchElementDx(key) * density());
+        v.setTranslationY(getTouchElementDy(key) * density());
+        if (v == leftJoystick) {
+            // The stick is resized through its layout params so the knob keeps working in
+            // real pixels; the travel radius is scaled to match (see setupFloatingJoystick).
+            leftStickScale = scale;
+            ViewGroup.LayoutParams lp = leftJoystick.getLayoutParams();
+            lp.width = dpToPixels(150 * scale);
+            lp.height = dpToPixels(150 * scale);
+            leftJoystick.setLayoutParams(lp);
+            ViewGroup.LayoutParams kp = leftJoystickKnob.getLayoutParams();
+            kp.width = dpToPixels(48 * scale);
+            kp.height = dpToPixels(48 * scale);
+            leftJoystickKnob.setLayoutParams(kp);
+        } else {
+            v.setScaleX(scale);
+            v.setScaleY(scale);
+            touchUserScale.put(v, scale);
+        }
+    }
+
+    // Where the fixed (non-floating) left stick sits: its layout position plus the saved offset.
+    private void updateLeftStickFixedPosition() {
+        if (leftJoystick == null || leftJoystick.getWidth() == 0) {
+            return;
+        }
+        leftStickFixedX = leftJoystick.getLeft() + getTouchElementDx("stick") * density();
+        leftStickFixedY = leftJoystick.getTop() + getTouchElementDy("stick") * density();
+        if (!touchLayoutEditing) {
+            applyTouchLeftStickMode();
+        }
+    }
+
+    public void startTouchLayoutEditFromNative() {
+        runOnUiThread(this::enterTouchLayoutEdit);
+    }
+
+    private void enterTouchLayoutEdit() {
+        if (overlayView == null || touchLayoutEditing) {
+            return;
+        }
+        touchLayoutEditing = true;
+        selectedTouchElement = null;
+
+        overlayView.setVisibility(View.VISIBLE);
+        buttonGroup.setVisibility(View.VISIBLE);
+        DisableTouchArea();
+        overlayView.setOnTouchListener((view, e) -> true);
+        overlayView.setBackgroundColor(0xAA000000);
+        buttonToggle.setVisibility(View.GONE);
+        applySavedTouchLayout();
+        leftJoystick.setVisibility(View.VISIBLE);
+
+        for (Map.Entry<String, View[]> entry : touchEditTargets.entrySet()) {
+            View.OnTouchListener listener = makeTouchEditListener(entry.getKey());
+            for (View target : entry.getValue()) {
+                if (target != null) {
+                    target.setOnTouchListener(listener);
+                }
+            }
+        }
+
+        buildTouchEditPanel();
+        refreshTouchEditOutlines();
+    }
+
+    private void exitTouchLayoutEdit() {
+        if (!touchLayoutEditing) {
+            return;
+        }
+        touchLayoutEditing = false;
+        selectedTouchElement = null;
+        clearTouchEditOutlines();
+
+        ViewGroup content = (ViewGroup) findViewById(android.R.id.content);
+        if (touchEditPanel != null) {
+            content.removeView(touchEditPanel);
+            touchEditPanel = null;
+        }
+        overlayView.setBackgroundColor(Color.TRANSPARENT);
+
+        for (View[] targets : touchEditTargets.values()) {
+            for (View target : targets) {
+                if (target != null) {
+                    target.setOnTouchListener(null);
+                }
+            }
+        }
+        installGameTouchListeners();
+        updateLeftStickFixedPosition();
+        applyTouchControlsVisibility();
+        applyTouchLeftStickMode();
+    }
+
+    private View.OnTouchListener makeTouchEditListener(final String key) {
+        return (v, event) -> {
+            View target = touchElements.get(key);
+            if (target == null) {
+                return false;
+            }
+            switch (event.getActionMasked()) {
+                case MotionEvent.ACTION_DOWN:
+                    selectTouchElement(key);
+                    dragLastRawX = event.getRawX();
+                    dragLastRawY = event.getRawY();
+                    return true;
+                case MotionEvent.ACTION_MOVE: {
+                    float dx = event.getRawX() - dragLastRawX;
+                    float dy = event.getRawY() - dragLastRawY;
+                    float oldX = target.getTranslationX();
+                    float oldY = target.getTranslationY();
+                    target.setTranslationX(oldX + dx);
+                    target.setTranslationY(oldY + dy);
+                    if (isTouchElementMostlyOnScreen(target)) {
+                        dragLastRawX = event.getRawX();
+                        dragLastRawY = event.getRawY();
+                    } else {
+                        // Don't let a control be dragged off-screen where it can't be grabbed.
+                        target.setTranslationX(oldX);
+                        target.setTranslationY(oldY);
+                    }
+                    return true;
+                }
+                case MotionEvent.ACTION_UP:
+                case MotionEvent.ACTION_CANCEL:
+                    saveTouchElementPosition(key);
+                    return true;
+                default:
+                    return true;
+            }
+        };
+    }
+
+    private boolean isTouchElementMostlyOnScreen(View target) {
+        Rect visible = new Rect();
+        if (!target.getGlobalVisibleRect(visible)) {
+            return false;
+        }
+        Float scale = touchUserScale.get(target);
+        float s = scale != null ? scale : 1.0f;
+        float fullArea = (float) target.getWidth() * s * target.getHeight() * s;
+        if (fullArea <= 0.0f) {
+            return true;
+        }
+        return (float) visible.width() * visible.height() >= fullArea * 0.6f;
+    }
+
+    private void saveTouchElementPosition(String key) {
+        View v = touchElements.get(key);
+        if (v == null) {
+            return;
+        }
+        preferences.edit()
+                .putFloat(PREF_TOUCH_LAYOUT_PREFIX + key + "_dx", v.getTranslationX() / density())
+                .putFloat(PREF_TOUCH_LAYOUT_PREFIX + key + "_dy", v.getTranslationY() / density())
+                .apply();
+        if (key.equals("stick")) {
+            updateLeftStickFixedPosition();
+        }
+    }
+
+    private void setTouchElementScale(String key, float scale) {
+        preferences.edit()
+                .putFloat(PREF_TOUCH_LAYOUT_PREFIX + key + "_scale", clampTouchScale(scale))
+                .apply();
+        applyTouchElementLayout(key);
+    }
+
+    private void resetTouchElement(String key) {
+        preferences.edit()
+                .remove(PREF_TOUCH_LAYOUT_PREFIX + key + "_dx")
+                .remove(PREF_TOUCH_LAYOUT_PREFIX + key + "_dy")
+                .remove(PREF_TOUCH_LAYOUT_PREFIX + key + "_scale")
+                .apply();
+        applyTouchElementLayout(key);
+        if (key.equals("stick")) {
+            leftJoystick.post(this::updateLeftStickFixedPosition);
+        }
+    }
+
+    private void selectTouchElement(String key) {
+        selectedTouchElement = key;
+        if (touchEditSeek != null) {
+            updatingTouchSeek = true;
+            touchEditSeek.setEnabled(true);
+            touchEditSeek.setProgress(Math.round((getTouchElementScale(key) - TOUCH_SCALE_MIN) * 100f));
+            updatingTouchSeek = false;
+        }
+        updateTouchEditLabel();
+        refreshTouchEditOutlines();
+    }
+
+    private void updateTouchEditLabel() {
+        if (touchEditLabel == null) {
+            return;
+        }
+        if (selectedTouchElement == null) {
+            touchEditLabel.setText("Drag a control to move it, then use the slider to resize");
+        } else {
+            touchEditLabel.setText(touchElementLabel(selectedTouchElement) + "  -  size "
+                    + Math.round(getTouchElementScale(selectedTouchElement) * 100f) + "%");
+        }
+    }
+
+    private void refreshTouchEditOutlines() {
+        for (Map.Entry<String, View> entry : touchElements.entrySet()) {
+            boolean selected = entry.getKey().equals(selectedTouchElement);
+            GradientDrawable outline = new GradientDrawable();
+            outline.setColor(Color.TRANSPARENT);
+            outline.setStroke(dpToPixels(selected ? 3 : 1), selected ? 0xFFFFD54F : 0x99FFFFFF);
+            outline.setCornerRadius(dpToPixels(6));
+            entry.getValue().setForeground(outline);
+        }
+    }
+
+    private void clearTouchEditOutlines() {
+        for (View v : touchElements.values()) {
+            v.setForeground(null);
+        }
+    }
+
+    private Button makeTouchEditButton(String text, View.OnClickListener onClick) {
