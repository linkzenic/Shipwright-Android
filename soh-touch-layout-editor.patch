+            }
+            if (selectedTouchElement != null) {
+                selectTouchElement(selectedTouchElement);
+            }
+        }));
+        row.addView(makeTouchEditButton("Done", v -> exitTouchLayoutEdit()));
+        panel.addView(row);
+
+        FrameLayout.LayoutParams lp = new FrameLayout.LayoutParams(
+                dpToPixels(320), FrameLayout.LayoutParams.WRAP_CONTENT);
+        lp.gravity = Gravity.TOP | Gravity.CENTER_HORIZONTAL;
+        lp.topMargin = dpToPixels(8);
+        content.addView(panel, lp);
+        touchEditPanel = panel;
+        updateTouchEditLabel();
+    }
