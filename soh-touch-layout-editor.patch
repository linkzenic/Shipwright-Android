--- a/termux/build-termux.sh
+++ b/termux/build-termux.sh
@@ -0,0 +1,160 @@
+#!/data/data/com.termux/files/usr/bin/bash
+# Build Ship of Harkinian (Android) directly inside Termux (aarch64).
+# Mirrors .github/workflows/android-standard-release.yml, with Termux substitutions:
+#   - NDK: a community aarch64 NDK (the official one only ships x86_64 binaries)
+#   - aapt2: Termux's own aapt2 (the Maven one is x86_64)
+#   - cmake/ninja: Termux's own
+#
+# Usage:   bash termux/build-termux.sh [release|debug]
+# Useful env overrides (all optional):
+#   NDK_URL, NDK_DIR_NAME, ANDROID_HOME, JOBS, LUS_REF, TORCH_REF, KEYSTORE
+#
+# Needs roughly: 8 GB RAM (or plenty of swap), ~25 GB free storage, and a LOT of time.
+set -euo pipefail
+
+VARIANT="${1:-release}"
+case "$VARIANT" in release|debug) ;; *) echo "variant must be release or debug"; exit 1;; esac
+
+ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
+cd "$ROOT"
+
+ANDROID_HOME="${ANDROID_HOME:-$HOME/android-sdk}"
+JOBS="${JOBS:-4}"
+# Community aarch64 NDK builds (https://github.com/Lzhiyong/termux-ndk). Verify the URL if it 404s.
+NDK_URL="${NDK_URL:-https://github.com/Lzhiyong/termux-ndk/releases/download/ndk-r26/android-ndk-r26b-aarch64.zip}"
+CMDLINE_URL="${CMDLINE_URL:-https://dl.google.com/android/repository/commandlinetools-linux-11076708_latest.zip}"
+KEYSTORE="${KEYSTORE:-$HOME/.soh-local-release.jks}"
+export ANDROID_HOME ANDROID_SDK_ROOT="$ANDROID_HOME"
+
+log() { printf '\n\033[1;32m==> %s\033[0m\n' "$*"; }
+die() { printf '\n\033[1;31mERROR: %s\033[0m\n' "$*" >&2; exit 1; }
+
+[ "$(uname -m)" = "aarch64" ] || die "This script expects an aarch64 device (found $(uname -m))."
+
+# ---------------------------------------------------------------- packages
+log "Installing Termux packages"
+pkg update -y
+pkg install -y git cmake ninja clang python openjdk-17 aapt2 libzip libpng zlib \
+    wget unzip zip patch pkg-config binutils
+export JAVA_HOME="${JAVA_HOME:-$PREFIX/lib/jvm/java-17-openjdk}"
+[ -x "$JAVA_HOME/bin/java" ] || die "JAVA_HOME ($JAVA_HOME) is wrong; set it to your JDK 17 directory."
+
+# ---------------------------------------------------------------- submodules
+need_clone() { [ -z "$(ls -A "$1" 2>/dev/null)" ]; }
+if need_clone libultraship || need_clone torch; then
+    if [ -d .git ]; then
+        log "Fetching submodules (pinned commits)"
+        git submodule update --init --recursive
+    else
+        log "No .git directory: cloning submodules from .gitmodules (UNPINNED)"
+        echo "WARNING: the commits pinned by the original repo are unknown here."
+        echo "         If the libultraship patch fails to apply, set LUS_REF=<commit>."
+        if need_clone libultraship; then
+            git clone --branch port-maintenance https://github.com/kenix3/libultraship.git libultraship
+            [ -z "${LUS_REF:-}" ] || git -C libultraship checkout "$LUS_REF"
+        fi
+        if need_clone torch; then
+            git clone https://github.com/HarbourMasters/Torch.git torch
+            [ -z "${TORCH_REF:-}" ] || git -C torch checkout "$TORCH_REF"
+        fi
+        # Torch has its own submodules.
+        git -C torch submodule update --init --recursive 2>/dev/null || true
+    fi
+fi
+
+# ---------------------------------------------------------------- libultraship Android patch
+PATCH="$ROOT/CMake/patches/libultraship-android.patch"
+if git -C libultraship apply --reverse --check "$PATCH" 2>/dev/null; then
+    log "libultraship Android patch already applied"
+else
+    log "Applying libultraship Android patch"
+    git -C libultraship apply --check "$PATCH" \
+        || die "libultraship-android.patch does not apply. Check out the libultraship commit this version was made for (LUS_REF)."
+    git -C libultraship apply "$PATCH"
+fi
+
+# ---------------------------------------------------------------- Android SDK
+SDKMANAGER="$ANDROID_HOME/cmdline-tools/latest/bin/sdkmanager"
+if [ ! -x "$SDKMANAGER" ]; then
+    log "Installing Android command-line tools"
+    mkdir -p "$ANDROID_HOME/cmdline-tools"
+    wget -q --show-progress -O /tmp/cmdline-tools.zip "$CMDLINE_URL"
+    unzip -q -o /tmp/cmdline-tools.zip -d "$ANDROID_HOME/cmdline-tools"
+    rm -rf "$ANDROID_HOME/cmdline-tools/latest"
+    mv "$ANDROID_HOME/cmdline-tools/cmdline-tools" "$ANDROID_HOME/cmdline-tools/latest"
+fi
+log "Installing SDK platform and build-tools"
+yes | "$SDKMANAGER" --sdk_root="$ANDROID_HOME" --licenses >/dev/null || true
+"$SDKMANAGER" --sdk_root="$ANDROID_HOME" "platforms;android-31" "build-tools;35.0.0"
+
+# ---------------------------------------------------------------- aarch64 NDK
+NDK_REV=""
+if ls "$ANDROID_HOME"/ndk/*/source.properties >/dev/null 2>&1; then
+    NDK_PROPS="$(ls "$ANDROID_HOME"/ndk/*/source.properties | head -n1)"
+else
+    log "Downloading aarch64 NDK"
+    mkdir -p "$ANDROID_HOME/ndk" /tmp/ndk-extract
+    wget -q --show-progress -O /tmp/ndk.zip "$NDK_URL" || die "Could not download the NDK from $NDK_URL (set NDK_URL)."
+    unzip -q -o /tmp/ndk.zip -d /tmp/ndk-extract
+    SRC="$(dirname "$(find /tmp/ndk-extract -maxdepth 2 -name source.properties | head -n1)")"
+    [ -n "$SRC" ] || die "Downloaded NDK archive has no source.properties."
+    REV="$(sed -n 's/^Pkg.Revision *= *//p' "$SRC/source.properties" | tr -d '\r')"
+    mkdir -p "$ANDROID_HOME/ndk/$REV"
+    cp -a "$SRC/." "$ANDROID_HOME/ndk/$REV/"
+    rm -rf /tmp/ndk-extract /tmp/ndk.zip
+    NDK_PROPS="$ANDROID_HOME/ndk/$REV/source.properties"
+fi
+NDK_REV="$(sed -n 's/^Pkg.Revision *= *//p' "$NDK_PROPS" | tr -d '\r')"
+log "Using NDK $NDK_REV"
+
+CMAKE_VER="$(cmake --version | head -n1 | sed 's/[^0-9.]*\([0-9.]*\).*/\1/')"
+log "Using Termux CMake $CMAKE_VER"
+
+cat > Android/local.properties <<LP
+sdk.dir=$ANDROID_HOME
+cmake.dir=$PREFIX
+LP
+
+# ---------------------------------------------------------------- host tools (soh.o2r)
+if [ ! -s build-host-tools/soh/soh.o2r ]; then
+    log "Building host tools and generating soh.o2r"
+    cmake -S . -B build-host-tools -G Ninja -DSOH_TOOLS_ONLY=ON -DCMAKE_BUILD_TYPE=Release
+    cmake --build build-host-tools --target GenerateSohOtr --parallel "$JOBS"
+    [ -s build-host-tools/soh/soh.o2r ] || die "soh.o2r was not generated."
+else
+    log "soh.o2r already exists, skipping host tools"
+fi
+
+# ---------------------------------------------------------------- signing (release)
+GRADLE_ARGS=(
+    "-Pandroid.aapt2FromMavenOverride=$PREFIX/bin/aapt2"
+    "-PsohNdkVersion=$NDK_REV"
+    "-PsohCmakeVersion=$CMAKE_VER"
+    "--console=plain" "--max-workers=$JOBS"
+)
+if [ "$VARIANT" = "release" ]; then
+    if [ ! -f "$KEYSTORE" ]; then
+        log "Creating a local signing key at $KEYSTORE"
+        keytool -genkeypair -v -keystore "$KEYSTORE" -alias soh -keyalg RSA -keysize 2048 \
+            -validity 10000 -storepass sohlocal -keypass sohlocal -dname "CN=SoH local build"
+    fi
+    GRADLE_ARGS+=("-PstoreFile=$KEYSTORE" "-PstorePassword=sohlocal" "-PkeyAlias=soh" "-PkeyPassword=sohlocal")
+fi
+
+# ---------------------------------------------------------------- gradle
+log "Building ($VARIANT). This takes a very long time on a phone."
+export CMAKE_BUILD_PARALLEL_LEVEL="$JOBS"
+export GRADLE_OPTS="-Dorg.gradle.native=false -Xmx3g"
+cd Android
+chmod +x gradlew
+TASK=":app:assemble$(echo "${VARIANT:0:1}" | tr a-z A-Z)${VARIANT:1}"
+./gradlew "$TASK" "${GRADLE_ARGS[@]}"
+
+APK="$(find app/build/outputs/apk/"$VARIANT" -maxdepth 1 -name '*.apk' | head -n1)"
+[ -n "$APK" ] || die "Build finished but no APK was found."
+log "APK: $ROOT/Android/$APK"
+if [ -d "$HOME/storage/downloads" ]; then
+    cp "$APK" "$HOME/storage/downloads/" && log "Copied to ~/storage/downloads (Download folder)"
+else
+    echo "Tip: run 'termux-setup-storage' to be able to copy the APK to your Download folder."
+fi
--- a/termux/LEEME-TERMUX.md
+++ b/termux/LEEME-TERMUX.md
@@ -0,0 +1,36 @@
+# Editor de layout táctil + build en Termux
+
+## Qué se agregó
+**Settings → Touch Controls → Edit Touch Layout** abre el editor:
+- Arrastra cualquier control (stick izquierdo en modo fijo, D-Pad, botones A/B/X/Y, ZL, L, ZR, R, Start, Back) para moverlo.
+- Toca un control para seleccionarlo (se marca en amarillo) y usa el slider para cambiar su tamaño (50 %–200 %).
+- **Reset** restablece el control seleccionado, **Reset All** todos, **Done** sale.
+- Atajo: mantener presionado el botón del ojito también abre el editor.
+- Todo se guarda solo (SharedPreferences) y se aplica al volver a abrir el juego.
+
+## Archivos modificados
+- `Android/app/src/main/java/com/dishii/soh/MainActivity.java` – lógica del editor.
+- `Android/app/src/main/res/layout/touchcontrol_overlay.xml` – el D-Pad ahora es un grupo (`dpad_cluster`) para moverlo/escalarlo como una pieza.
+- `soh/soh/SohGui/SohMenuSettings.cpp` – botón "Edit Touch Layout" + llamada JNI.
+- `Android/app/build.gradle` – `sohNdkVersion` / `sohCmakeVersion` configurables (por defecto igual que antes).
+- `termux/build-termux.sh` – script de build.
+
+## Compilar en Termux
+```
+pkg install git
+cd Shipwright-Android-9.3.0-android.1
+bash termux/build-termux.sh release     # o: debug
+```
+El script sigue la receta de `.github/workflows/android-standard-release.yml` con estas sustituciones:
+NDK aarch64 de la comunidad (el oficial solo trae binarios x86_64), `aapt2`/`cmake`/`ninja` de Termux,
+y keystore local para firmar.
+
+## Cosas a tener en cuenta (importante)
+1. **Los submódulos `libultraship` y `torch` venían vacíos en el zip.** Si tienes el repo con `.git`, el script usa los commits fijados.
+   Si no, clona las ramas actuales y puede que `libultraship-android.patch` no aplique; en ese caso usa `LUS_REF=<commit>`.
+2. **No pude compilar ni probar nada aquí** (sin Android SDK/NDK ni internet en mi entorno). El Java lo revisé por sintaxis y el script con `bash -n`,
+   pero el build completo y el editor en pantalla no están probados en un dispositivo.
+3. Compilar SoH completo en un teléfono necesita ~8 GB de RAM (o swap), ~25 GB libres y varias horas.
+4. El APK `release` se firma con tu keystore local, así que no se instala encima del APK oficial: desinstala primero
+   (tus saves están en `/storage/emulated/0/SOH`, no se pierden). `debug` usa otro id (`.localtest`) y otra carpeta (`SOH93-Test`).
+5. Si la URL del NDK falla, pasa otra: `NDK_URL=https://... bash termux/build-termux.sh`.
