+                LinearLayout.LayoutParams.MATCH_PARENT, LinearLayout.LayoutParams.WRAP_CONTENT));
+
+        touchEditSeek = new SeekBar(this);
+        touchEditSeek.setMax(Math.round((TOUCH_SCALE_MAX - TOUCH_SCALE_MIN) * 100f));
+        touchEditSeek.setEnabled(false);
+        touchEditSeek.setOnSeekBarChangeListener(new SeekBar.OnSeekBarChangeListener() {
+            @Override
+            public void onProgressChanged(SeekBar seekBar, int progress, boolean fromUser) {
